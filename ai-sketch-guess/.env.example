# Which AI judges the drawings: gemini (default), claude, ollama, or mock (random scores, no API call)
JUDGE_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (only needed if JUDGE_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ollama (only needed if JUDGE_PROVIDER=ollama). The model must support images.
# From Docker on the same machine, use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# How long to wait for the judge before retrying, in milliseconds (local models may need more)
JUDGE_TIMEOUT_MS=20000

# Optional: require this PIN to open the host screen
HOST_PIN=

PORT=3000
